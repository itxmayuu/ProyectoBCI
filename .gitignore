# ==========================================
# GESTIÓN DE DATOS PESADOS (DATA)
# ==========================================
# Ignorar todo el contenido pesado dentro de data/
data/raw/*
data/processed/*

# Excepción: mantener los marcadores de carpeta
!data/raw/.gitkeep
!data/processed/.gitkeep

# Archivos de datos pesados y temporales
*.mat
*.csv
*.txt
*.crdownload
*.zip
*.tar.gz

# ==========================================
# MATLAB
# ==========================================
*.asv
*.m~
*.slxc
*.mex*
slprj/
_UpgradeReport_Files/

# ==========================================
# PYTHON (Jupyter y entornos virtuales)
# ==========================================
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.venv
venv/
env/

# ==========================================
# SISTEMA OPERATIVO Y EDITORES
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
